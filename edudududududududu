        const email = el("aEmail").value.trim(), pass = el("aPass").value, reg = authMode === "register";
        if (!email || !pass) return authMsg("Nhập email và mật khẩu.", true);
        if (!sbReady()) return authMsg("Chưa cấu hình Supabase (SB_KEY).", true);
        const wantTeacher = reg && el("aRole").value === "teacher";
