    function refreshChainEditUI() {
        el("addChainBtn").textContent = editingChain >= 0 ? `💾 Lưu thay đổi (chuỗi ${editingChain + 1})` : "➕ Thêm chuỗi";
        el("cancelEditChain").style.display = editingChain >= 0 ? "inline-block" : "none";
    }

    function startEditChain(i) {
        const c = chainData[i];
        if (!c) return;
        el("chainTitle").value = c.title;
        el("chainSeq").value = c.sequence.join(", ");
        updateChainPreview();
        editingChain = i;
        refreshChainEditUI();
        el("chainTitle").scrollIntoView({ behavior: "smooth", block: "center" });
        el("chainTitle").focus();
    }

    function cancelEditChain() {
        editingChain = -1;
        el("chainTitle").value = "";
        el("chainSeq").value = "";
        updateChainPreview();
        refreshChainEditUI();
    }

    function addChain() {
        const title = document.getElementById("chainTitle").value.trim();
        const seq = parseSeq(document.getElementById("chainSeq").value);
        if (!title || seq.length < 2) { alert("Cần nhập đề bài và ít nhất 2 phần tử cho chuỗi!"); return; }
        const ci = editingChain;
        const oldC = ci >= 0 ? chainData[ci] : null;
        if (ci >= 0) chainData[ci] = { title, sequence: seq }; else chainData.push({ title, sequence: seq });
        if (!saveChains()) { if (ci >= 0) chainData[ci] = oldC; else chainData.pop(); return; }
        editingChain = -1;
        refreshChainEditUI();
        document.getElementById("chainTitle").value = "";
        document.getElementById("chainSeq").value = "";
        updateChainPreview();
        renderChainList();
    }

    function removeChain(i) {
        if (editingChain === i) cancelEditChain(); else if (editingChain > i) { editingChain--; refreshChainEditUI(); }
        chainData.splice(i, 1); saveChains(); renderChainList(); }

    function resetChains() {
        if (confirm("Khôi phục danh sách chuỗi mặc định?")) { chainData = cloneChains(); cancelEditChain(); saveChains(); renderChainList(); }
