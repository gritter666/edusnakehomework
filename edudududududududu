    // IMPORT ẢNH CHO TỪNG CÂU HỎI
    // ==========================================
    const MAX_IMG_SIZE = 400;      // px, cạnh dài nhất sau khi thu nhỏ
    const MAX_IMG_FILE_MB = 10;    // giới hạn file gốc
    let pendingImage = "";         // ảnh đang chọn cho câu hỏi mới (data URL hoặc URL)

    // Đọc file ảnh -> thu nhỏ -> trả về data URL
    function fileToResizedDataURL(file) {
        return new Promise((resolve, reject) => {
            if (!file || !file.type.startsWith("image/")) {
                reject(new Error("File không phải là ảnh."));
                return;
            }
            if (file.size > MAX_IMG_FILE_MB * 1024 * 1024) {
                reject(new Error("Ảnh quá lớn (tối đa " + MAX_IMG_FILE_MB + "MB)."));
                return;
            }
            const reader = new FileReader();
            reader.onerror = () => reject(new Error("Không đọc được file."));
            reader.onload = () => {
                const img = new Image();
                img.onerror = () => reject(new Error("Không mở được ảnh."));
                img.onload = () => {
                    const scale = Math.min(1, MAX_IMG_SIZE / Math.max(img.width, img.height));
                    const w = Math.max(1, Math.round(img.width * scale));
                    const h = Math.max(1, Math.round(img.height * scale));
                    const c = document.createElement("canvas");
                    c.width = w; c.height = h;
                    c.getContext("2d").drawImage(img, 0, 0, w, h);
                    // PNG/GIF/WebP giữ nền trong suốt, còn lại dùng JPEG cho nhẹ
                    const keepAlpha = /png|gif|webp|svg/.test(file.type);
                    resolve(keepAlpha ? c.toDataURL("image/png") : c.toDataURL("image/jpeg", 0.85));
                };
                img.src = reader.result;
            };
            reader.readAsDataURL(file);
        });
    }

