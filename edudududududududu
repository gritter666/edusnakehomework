    async function sb(path, opt = {}) {
        if (session && !path.startsWith("/auth/") && Date.now() / 1000 > session.expires_at - 30) await refreshSession();
        const r = await fetch(SB_URL + path, {
            method: opt.method || "GET",
            headers: { apikey: SB_KEY, ...(sbToken ? { Authorization: "Bearer " + sbToken } : {}), "Content-Type": "application/json", Prefer: "return=representation" },
            body: opt.body ? JSON.stringify(opt.body) : undefined
        });
        const data = await r.json().catch(() => null);
        if (!r.ok) throw new Error((data && (data.message || data.msg || data.error_description)) || r.statusText);
        return data;
    }

