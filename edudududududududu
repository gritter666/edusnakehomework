        if (!confirm("Ghi đè bộ đề đang chọn bằng ngân hàng hiện tại trên máy bạn?")) return;
        try {
            await sb(`/rest/v1/question_sets?id=eq.${currentSetId}`, { method: "PATCH", body: { questions: customQuestions, chains: chainData, updated_at: new Date().toISOString() } });
            setBarMsg("Đã cập nhật bộ đề.");
        } catch (e) { setBarMsg("Lỗi: " + e.message, true); }
    }

    async function deleteSet() {
        if (!currentSetId) return setBarMsg("Hãy chọn bộ đề cần xóa.", true);
        if (!confirm("Xóa bộ đề đang chọn? (Các bài đã giao từ bộ đề này vẫn giữ nguyên.)")) return;
        try {
            await sb(`/rest/v1/question_sets?id=eq.${currentSetId}`, { method: "DELETE" });
            currentSetId = "";
            await loadSets();
            setBarMsg("Đã xóa bộ đề.");
        } catch (e) { setBarMsg("Lỗi: " + e.message, true); }
    }

    // KHỞI TẠO TRANG CHỦ
    initAuth();
    initFormulaToolbar();
    ["chainTitle", "chainSeq"].forEach(id => {
        const el = document.getElementById(id);
        el.addEventListener("focus", () => { lastField = el; });
        el.addEventListener("input", updateChainPreview);
    });
    returnToHomeScreen();
</script>

</body>
</html>
