<script>
    // ==========================================
    // AUDIO SYNTHESIS (Web Audio API)
    // ==========================================
    const AudioCtx = new (window.AudioContext || window.webkitAudioContext)();
    let bgmInterval = null;

    function playSound(freq, duration, type = "sine") {
        const sfxVol = document.getElementById("sfxVol").value / 100;
        if (sfxVol <= 0) return;
        try {
            const osc = AudioCtx.createOscillator();
            const gain = AudioCtx.createGain();
            osc.type = type;
            osc.frequency.setValueAtTime(freq, AudioCtx.currentTime);
            gain.gain.setValueAtTime(sfxVol * 0.3, AudioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, AudioCtx.currentTime + duration);
            osc.connect(gain);
            gain.connect(AudioCtx.destination);
            osc.start();
            osc.stop(AudioCtx.currentTime + duration);
        } catch(e) {}
    }

    function startBGM() {
        stopBGM();
        bgmInterval = setInterval(() => {
            const bgmVol = document.getElementById("bgmVol").value / 100;
            if (bgmVol <= 0) return;
            try {
                const osc = AudioCtx.createOscillator();
                const gain = AudioCtx.createGain();
                osc.type = "triangle";
                osc.frequency.setValueAtTime(220, AudioCtx.currentTime);
                gain.gain.setValueAtTime(bgmVol * 0.05, AudioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, AudioCtx.currentTime + 0.4);
                osc.connect(gain);
                gain.connect(AudioCtx.destination);
                osc.start();
                osc.stop(AudioCtx.currentTime + 0.4);
            } catch(e) {}
        }, 800);
    }

    function stopBGM() {
        if (bgmInterval) clearInterval(bgmInterval);
    }

    function updateAudioSettings() {
        document.getElementById("bgmVolText").textContent = document.getElementById("bgmVol").value + "%";
        document.getElementById("sfxVolText").textContent = document.getElementById("sfxVol").value + "%";
    }

    // ==========================================
    // HELPER: KATEX MATHEMATICAL RENDERER
    // ==========================================
    const SYM = {pi:'π',infty:'∞',int:'∫',iint:'∬',oint:'∮',sum:'∑',prod:'∏',alpha:'α',beta:'β',gamma:'γ',delta:'δ',theta:'θ',lambda:'λ',mu:'μ',sigma:'σ',omega:'ω',Delta:'Δ',Omega:'Ω',le:'≤',leq:'≤',ge:'≥',geq:'≥',ne:'≠',neq:'≠',approx:'≈',pm:'±',times:'×',cdot:'·',div:'÷',to:'→',rightarrow:'→',Rightarrow:'⇒',in:'∈',cup:'∪',cap:'∩',partial:'∂',nabla:'∇',forall:'∀',exists:'∃',emptyset:'∅'};
    const SUP = {'0':'⁰','1':'¹','2':'²','3':'³','4':'⁴','5':'⁵','6':'⁶','7':'⁷','8':'⁸','9':'⁹','n':'ⁿ','+':'⁺','-':'⁻'};
    const SUB = {'0':'₀','1':'₁','2':'₂','3':'₃','4':'₄','5':'₅','6':'₆','7':'₇','8':'₈','9':'₉','i':'ᵢ','n':'ₙ','x':'ₓ'};

    function mapScript(str, map, mark) {
        return [...str].every(c => map[c]) ? [...str].map(c => map[c]).join('') : mark + '(' + str + ')';
    }

    // Đổi LaTeX sang chữ thường/ký hiệu Unicode (dùng để vẽ nhãn mồi trên canvas)
    function latexToPlain(t) {
        let s = String(t).replace(/\$/g, '');
        for (let i = 0; i < 3; i++) s = s.replace(/\\frac\s*\{([^{}]*)\}\s*\{([^{}]*)\}/g, '$1/$2');
        s = s.replace(/\\sqrt\s*\{([^{}]*)\}/g, '√$1');
        s = s.replace(/\^\{([^{}]*)\}|\^(\w)/g, (m, a, b) => mapScript(a || b, SUP, '^'));
        s = s.replace(/_\{([^{}]*)\}|_(\w)/g, (m, a, b) => mapScript(a || b, SUB, '_'));
        s = s.replace(/\\([a-zA-Z]+)/g, (m, c) => SYM[c] ?? c);
        return s.replace(/\\[,;!]/g, '').replace(/[{}\\]/g, '').replace(/\s+/g, ' ').trim();
    }

    // Tách chuỗi thành các đoạn chữ / công thức. Ưu tiên $...$; nếu không có thì tự nhận diện.
    function segmentMath(text) {
        if (text.includes('$')) {
            const parts = text.split('$');
            return parts.map((s, i) => ({ math: i % 2 === 1 && i < parts.length - 1, s })).filter(p => p.s);
        }
        const tk = text.split(/(\s+)/);
        const tp = tk.map(w => (w.match(/[?.,;:!]+$/) || [''])[0]);
        const kind = tk.map((w, i) => {
            if (i % 2) return 0;
            const c = w.slice(0, w.length - tp[i].length);
            if (!c) return 0;
            if (/\\[a-zA-Z]|[\^_]/.test(c)) return 2;
            return /^[0-9a-zA-Z+\-*\/=().<>|{}\\']+$/.test(c) && !/[a-zA-Z]{4,}/.test(c.replace(/\\[a-zA-Z]+/g, '')) ? 1 : 0;
        });
        const inMath = kind.map(k => k === 2);
        for (let i = 0; i < tk.length; i += 2) {
            if (kind[i] !== 2) continue;
            for (let j = i - 2; j >= 0 && kind[j] === 1 && !tp[j]; j -= 2) inMath[j] = true;
            for (let j = i; !tp[j] && j + 2 < tk.length && kind[j + 2] === 1; j += 2) inMath[j + 2] = true;
        }
        const out = [];
        const push = (math, s) => {
            if (!s) return;
            const l = out[out.length - 1];
            if (l && l.math === math) l.s += s; else out.push({ math, s });
        };
        tk.forEach((w, i) => {
            if (i % 2) { push(!!(inMath[i - 1] && inMath[i + 1]), w); return; }
            if (inMath[i]) { const c = w.slice(0, w.length - tp[i].length); push(true, c); push(false, tp[i]); }
            else push(false, w);
        });
        return out;
    }

    function renderLatexText(element, text) {
        element.innerHTML = "";
        segmentMath(String(text)).forEach(p => {
            if (!p.math) { element.appendChild(document.createTextNode(p.s)); return; }
            const span = document.createElement("span");
            const big = /\\(sum|int|prod|lim)/.test(p.s);
            try {
                if (typeof katex === "undefined") throw 0;
                katex.render((big ? "\\displaystyle " : "") + p.s, span, { throwOnError: false });
            } catch (e) { span.textContent = latexToPlain(p.s); }
            element.appendChild(span);
        });
    }

    // Hiển thị ảnh minh họa ở khung bên cạnh sân chơi
    const LETTERS = ["A", "B", "C", "D", "E", "F", "G", "H"];

    // Vẽ danh sách đáp án A/B/C ở khung bên trái (null = xóa/để trống)
    function renderAnswerPanel(items) {
        const list = document.getElementById("answerList");
        list.innerHTML = "";
        if (!items) {
            const e = document.createElement("div");
            e.className = "side-empty";
            e.textContent = "Đáp án A / B / C sẽ hiện ở đây khi chơi chế độ học";
            list.appendChild(e);
            return;
        }
        items.forEach((t, i) => {
            const row = document.createElement("div");
            row.className = "answer-item";
            const letter = document.createElement("div");
            letter.className = "answer-letter";
            letter.textContent = LETTERS[i];
            const txt = document.createElement("span");
            renderLatexText(txt, t);
            row.appendChild(letter);
            row.appendChild(txt);
            list.appendChild(row);
        });
    }

    function showQuestionImage(src) {
        renderAnswerPanel(null); // làm mới cả khung đáp án; mồi mới sẽ điền lại ngay sau đó
        const img = document.getElementById("qImg");
        const empty = document.getElementById("qImgEmpty");
        img.onload = img.onerror = null;
        img.style.display = "none";
        empty.style.display = "block";
        empty.textContent = "Câu hỏi này không có ảnh";
        if (!src || !src.trim()) { img.removeAttribute("src"); return; }
        img.onload = () => { img.style.display = "block"; empty.style.display = "none"; };
        img.onerror = () => { img.style.display = "none"; empty.style.display = "block"; empty.textContent = "Không tải được ảnh"; };
        img.src = src;
    }

    // Thanh công thức trong hộp thoại thêm câu hỏi
    const FORMULAS = [
        ['\\int_{0}^{1} x\\,dx', '\\int'], ['\\sum_{i=1}^{n} i', '\\sum'], ['\\prod_{i=1}^{n} i', '\\prod'],
        ['\\lim_{x \\to 0} \\frac{\\sin x}{x}', '\\lim'], ['\\frac{a}{b}', '\\frac{a}{b}'], ['\\sqrt{x}', '\\sqrt{x}'],
        ['\\sqrt[3]{x}', '\\sqrt[3]{x}'], ['x^{2}', 'x^n'], ['x_{1}', 'x_i'], ['\\frac{d}{dx}', '\\frac{d}{dx}'],
        ['\\binom{n}{k}', '\\binom{n}{k}'], ['|x|', '|x|'], ['\\pi', '\\pi'], ['\\infty', '\\infty'],
        ['\\le', '\\le'], ['\\ge', '\\ge'], ['\\ne', '\\ne'], ['\\pm', '\\pm'], ['\\times', '\\times'], ['\\div', '\\div'],
        ['\\to', '\\to'], ['\\alpha', '\\alpha'], ['\\theta', '\\theta'], ['\\Delta', '\\Delta'],
        ['\\sin x', '\\sin'], ['\\cos x', '\\cos'], ['\\log_{2} x', '\\log'], ['\\ln x', '\\ln'],
        ['\\in', '\\in'], ['\\cup', '\\cup'], ['\\cap', '\\cap']
    ];
    let lastField = null;

    function insertFormula(code) {
        const el = lastField || document.getElementById("customQ");
        const a = el.selectionStart ?? el.value.length;
        const b = el.selectionEnd ?? a;
        const before = el.value.slice(0, a);
        const inside = (before.split("$").length - 1) % 2 === 1;
        const ins = inside ? code : "$" + code + "$";
        el.value = before + ins + el.value.slice(b);
        el.focus();
        el.setSelectionRange(a + ins.length, a + ins.length);
        updateQPreview();
    }

    function updateQPreview() {
        const box = document.getElementById("qPreview");
        box.innerHTML = "";
        [["customQ", "❓ "], ["customAns", "✔ "], ["customOpt1", "✘ "], ["customOpt2", "✘ "]].forEach(([id, icon]) => {
            const v = document.getElementById(id).value.trim();
            if (!v) return;
            const row = document.createElement("div");
            row.appendChild(document.createTextNode(icon));
            const sp = document.createElement("span");
            renderLatexText(sp, v);
            row.appendChild(sp);
            box.appendChild(row);
        });
        box.style.display = box.children.length ? "block" : "none";
    }

    function initFormulaToolbar() {
        const bar = document.getElementById("formulaBar");
        FORMULAS.forEach(([code, label]) => {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "fbtn";
            btn.title = code;
            btn.onmousedown = e => e.preventDefault();
            btn.onclick = () => insertFormula(code);
            try { katex.render(label, btn, { throwOnError: false }); } catch (e) { btn.textContent = latexToPlain(label); }
            bar.appendChild(btn);
        });
        ["customQ", "customAns", "customOpt1", "customOpt2"].forEach(id => {
            const el = document.getElementById(id);
            el.addEventListener("focus", () => { lastField = el; });
            el.addEventListener("input", updateQPreview);
        });
    }

    // ==========================================
    // CORE GAME STATE & DATA
    // ==========================================
    const canvas = document.getElementById("gameCanvas");
    const ctx = canvas.getContext("2d");

    let box = 22;
    let cols = canvas.width / box;
    let rows = canvas.height / box;

    let gameState = "HOME"; // HOME, PLAYING, PAUSED, GAME_OVER
    let gameLoop = null;
    let timerInterval = null;
    let gameTimeSeconds = 0;

    let snake = [];
    let botSnake = [];
    let foods = [];
    let direction = "RIGHT";
    let nextDirection = "RIGHT";
    let score = 0;
    let botScore = 0;
    let speed = 100;

    let currentMode = "smartFood";
    let currentQuestion = null;
    let currentChain = null;
    let chainIndex = 0;
    let isPoisoned = false;
    let poisonTimer = null;

    let keyBinds = {
        UP: ["ArrowUp", "w", "W"],
        DOWN: ["ArrowDown", "s", "S"],
        LEFT: ["ArrowLeft", "a", "A"],
        RIGHT: ["ArrowRight", "d", "D"]
    };

    // MẪU CÂU HỎI MẶC ĐỊNH (CÓ CÔNG THỨC TÍCH PHÂN & HÌNH ẢNH)
    const initialDefaultQuestions = [
        { q: "Tính $\\sum_{i=1}^{4} i$ = ?", options: ["10", "8", "12"], answer: "10", image: "" },
        { q: "Tính $\\lim_{x \\to 0} \\frac{\\sin x}{x}$ = ?", options: ["1", "0", "∞"], answer: "1", image: "" },
        { q: "Tính $\\prod_{i=1}^{4} i$ = ?", options: ["24", "10", "12"], answer: "24", image: "" },
        { 
            q: "Tính tích phân: $\\int_0^1 2x\\,dx$ = ?", 
            options: ["1", "2", "0"], 
            answer: "1", 
            image: "" 
        },
        { 
            q: "Tính đạo hàm của $f(x) = x^2$ ?", 
            options: ["2x", "x", "x^3"], 
            answer: "2x", 
            image: "" 
        },
        { 
            q: "Biển báo dưới đây có ý nghĩa gì?", 
            options: ["Cấm đi ngược chiều", "Cấm đỗ xe", "Đường một chiều"], 
            answer: "Cấm đi ngược chiều", 
            image: "https://upload.wikimedia.org/wikipedia/commons/thumb/1/11/Vietnam_road_sign_P102.svg/120px-Vietnam_road_sign_P102.svg.png" 
        },
        { 
            q: "Tính: $\\frac{1}{2} + \\frac{1}{2}$ = ?", 
            options: ["1", "1/4", "2"], 
            answer: "1", 
            image: "" 
        }
    ];

    const CHAIN_KEY = "snakeChainQuestionsV1";
    const defaultChains = [
        { title: "Ghép từ Tiếng Anh: 'LEARN'", sequence: ["L", "E", "A", "R", "N"] },
        { title: "Thứ tự Nguyên phân: Kỳ...", sequence: ["Đầu", "Giữa", "Sau", "Cuối"] },
        { title: "Dãy số nguyên tố tăng dần:", sequence: ["2", "3", "5", "7", "11"] }
    ];
    function cloneChains() { return JSON.parse(JSON.stringify(defaultChains)); }
    let chainData;
    try { chainData = JSON.parse(localStorage.getItem(CHAIN_KEY)) || cloneChains(); } catch (e) { chainData = cloneChains(); }

    function cloneDefaults() { return JSON.parse(JSON.stringify(initialDefaultQuestions)); }

    let customQuestions;
    try {
        customQuestions = JSON.parse(localStorage.getItem("snakeCustomQuestionsV2")) || cloneDefaults();
    } catch (e) {
        customQuestions = cloneDefaults();
    }

    function saveQuestions() {
        if (activeAssignment) return true; // đang làm bài của giáo viên: không ghi đè dữ liệu cá nhân
        try {
            localStorage.setItem("snakeCustomQuestionsV2", JSON.stringify(customQuestions));
            return true;
        } catch (e) {
            alert("Bộ nhớ trình duyệt đã đầy, không thể lưu thêm ảnh. Hãy xóa bớt ảnh hoặc dùng ảnh nhỏ hơn / URL ảnh.");
            return false;
        }
    }

    // ==========================================
    // CONTROLS & INPUT MANAGEMENT
    // ==========================================
    document.addEventListener("keydown", function(event) {
        if (AudioCtx.state === 'suspended') AudioCtx.resume();

        if (event.key === "Escape") {
            if (gameState === "PLAYING") pauseGame();
            else if (gameState === "PAUSED") resumeGame();
            return;
        }

        if (gameState !== "PLAYING") return;

        const key = event.key;
        let mappedDir = null;

        if (keyBinds.UP.includes(key)) mappedDir = isPoisoned ? "DOWN" : "UP";
        else if (keyBinds.DOWN.includes(key)) mappedDir = isPoisoned ? "UP" : "DOWN";
        else if (keyBinds.LEFT.includes(key)) mappedDir = isPoisoned ? "RIGHT" : "LEFT";
        else if (keyBinds.RIGHT.includes(key)) mappedDir = isPoisoned ? "LEFT" : "RIGHT";

        if (mappedDir) {
            event.preventDefault();
            if (mappedDir === "LEFT" && direction !== "RIGHT") nextDirection = "LEFT";
            if (mappedDir === "UP" && direction !== "DOWN") nextDirection = "UP";
            if (mappedDir === "RIGHT" && direction !== "LEFT") nextDirection = "RIGHT";
            if (mappedDir === "DOWN" && direction !== "UP") nextDirection = "DOWN";
        }
    });

    function listenKey(action) {
        const btn = document.getElementById(`keyBtn_${action}`);
        btn.textContent = "Bấm phím...";
        
        const handler = (e) => {
            e.preventDefault();
            keyBinds[action] = [e.key];
            btn.textContent = e.key;
            window.removeEventListener("keydown", handler);
            updateControlGuide();
        };
        window.addEventListener("keydown", handler, { once: true });
    }

    function updateControlGuide() {
        document.getElementById("controlGuideText").textContent = 
            `Di chuyển: [${keyBinds.UP[0]}, ${keyBinds.LEFT[0]}, ${keyBinds.DOWN[0]}, ${keyBinds.RIGHT[0]}] | Esc: Tạm dừng | Xuyên tường OK`;
    }

    // ==========================================
    // SCREEN & MODE NAVIGATION
    // ==========================================
    function selectModeAndStart(mode) {
        document.getElementById("gameMode").value = mode;
        startNewGame();
    }

    function changeModeInGame() {
        if (gameState === "PLAYING" || gameState === "PAUSED") {
            startNewGame();
        }
    }

    let snakeHead = "#22c55e", snakeBody = "#4ade80";
    function applyTheme(hard) {
        document.body.classList.toggle("hard", hard);
        snakeHead = hard ? "#ef4444" : "#22c55e";
        snakeBody = hard ? "#f87171" : "#4ade80";
    }

    function startNewGame() {
        currentMode = document.getElementById("gameMode").value;
        applyTheme(currentMode === "hard");
        snake = [
            { x: 8 * box, y: 10 * box },
            { x: 7 * box, y: 10 * box },
            { x: 6 * box, y: 10 * box }
        ];

        direction = "RIGHT";
        nextDirection = "RIGHT";
        score = 0;
        botScore = 0;
        gameTimeSeconds = 0;
        isPoisoned = false;

        document.getElementById("score").textContent = score;
        document.getElementById("timeText").textContent = "00:00";

        const botContainer = document.getElementById("botScoreContainer");
        if (currentMode === "versus") {
            botContainer.style.display = "inline";
            document.getElementById("botScore").textContent = botScore;
            botSnake = [
                { x: 20 * box, y: 18 * box },
                { x: 21 * box, y: 18 * box },
                { x: 22 * box, y: 18 * box }
            ];
        } else {
            botContainer.style.display = "none";
        }

        setupQuestionOrChain();

        hideAllScreens();
        gameState = "PLAYING";

        startBGM();
