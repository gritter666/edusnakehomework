    function authMsg(t, bad) { const m = el("authMsg"); m.textContent = t; m.style.color = bad ? "#f87171" : "#4ade80"; }

    function viErr(m) {
        const map = [["Invalid login credentials", "Sai email hoặc mật khẩu."], ["User already registered", "Email này đã được đăng ký."],
            ["Email not confirmed", "Email chưa được xác nhận — hãy kiểm tra hộp thư."], ["Failed to fetch", "Không kết nối được máy chủ, kiểm tra mạng."],
            ["Password should be", "Mật khẩu quá yếu (tối thiểu 6 ký tự)."], ["valid email", "Email không hợp lệ."], ["rate limit", "Thao tác quá nhanh, thử lại sau ít phút."]];
        const hit = map.find(([k]) => String(m).includes(k));
        return hit ? hit[1] : String(m);
    }

