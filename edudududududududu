    // GAME LOGIC & FOOD GENERATION
    // ==========================================
    function updateChainPrompt() {
        const qBox = document.getElementById("questionBox");
        qBox.innerHTML = "🔗 <b></b> | Tiếp theo: <span style='color:var(--accent-light); font-size:17px; margin-left:5px;'></span>";
        renderLatexText(qBox.querySelector("b"), currentChain.title);
        renderLatexText(qBox.querySelector("span"), currentChain.sequence[chainIndex]);
    }

    function setupQuestionOrChain() {
        const qBox = document.getElementById("questionBox");
        showQuestionImage("");
        
        if (currentMode === "arcade") {
            qBox.innerHTML = "🕹️ <b>Chế độ Thuần Giải Trí:</b> Ăn mồi xanh (+10đ), tránh mồi đỏ!";
            generateArcadeFoods();
        } else if (["smartFood", "versus", "hard"].includes(currentMode)) {
            if (customQuestions.length === 0) {
                qBox.innerHTML = "⚠️ Chưa có câu hỏi nào!";
                foods = [];
                return;
            }
            currentQuestion = customQuestions[Math.floor(Math.random() * customQuestions.length)];
            
            // Render tiêu đề + Công thức LaTeX
            qBox.innerHTML = "❓ <b>Hỏi:</b> &nbsp;";
            let textSpan = document.createElement("span");
            renderLatexText(textSpan, currentQuestion.q);
            qBox.appendChild(textSpan);

            // Kiểm tra và hiển thị ảnh minh họa nếu có
            showQuestionImage(currentQuestion.image);

            generateSmartFoods();
        } else if (currentMode === "chain") {
            if (chainData.length === 0) {
                qBox.innerHTML = "⚠️ Chưa có chuỗi nào! Thêm trong Ngân hàng câu hỏi → tab Nối chuỗi.";
                foods = [];
                return;
            }
            currentChain = chainData[Math.floor(Math.random() * chainData.length)];
            chainIndex = 0;
            updateChainPrompt();
            generateChainFoods();
        }
    }

    function getRandomPos() {
        let x, y, isOverlap;
        do {
            isOverlap = false;
            x = Math.floor(Math.random() * cols) * box;
            y = Math.floor(Math.random() * rows) * box;
            for (let part of snake) { if (part.x === x && part.y === y) isOverlap = true; }
            if (currentMode === "versus") {
                for (let part of botSnake) { if (part.x === x && part.y === y) isOverlap = true; }
            }
            for (let f of foods) { if (f.x === x && f.y === y) isOverlap = true; }
        } while (isOverlap);
        return { x, y };
    }

    function generateArcadeFoods() {
        foods = [];
        let pos1 = getRandomPos();
        foods.push({ x: pos1.x, y: pos1.y, text: "+10", isCorrect: true, type: "good" });
        
        let pos2 = getRandomPos();
        foods.push({ x: pos2.x, y: pos2.y, text: "💣", isCorrect: false, type: "bad" });
    }

    // Chế độ Siêu Khó: thêm 5 đáp án sai (ưu tiên số gần đáp án, rồi đến đáp án của câu khác)
    function buildOptions() {
        const base = [...currentQuestion.options];
        if (currentMode !== "hard") return base;
        const have = new Set(base);
        const extra = [];
        const add = v => {
            v = String(v);
            if (extra.length < 5 && !have.has(v)) { have.add(v); extra.push(v); }
        };
        const ans = String(currentQuestion.answer);
        if (/^-?\d+(\.\d+)?$/.test(ans)) {
            const n = parseFloat(ans);
            [n + 1, n - 1, n + 2, n - 2, n * 2, -n, n + 10, n / 2, n + 3, n - 3].forEach(v => add(+v.toFixed(2)));
        }
        const pool = customQuestions.flatMap(q => q.options).concat(chainData.flatMap(c => c.sequence));
        pool.sort(() => Math.random() - 0.5).forEach(add);
        return base.concat(extra);
    }

    function generateSmartFoods() {
        foods = [];
        buildOptions().sort(() => Math.random() - 0.5).forEach((opt, i) => {
            const pos = getRandomPos();
            foods.push({ x: pos.x, y: pos.y, text: opt, label: LETTERS[i], isCorrect: opt === currentQuestion.answer });
        });
        renderAnswerPanel(foods.map(f => f.text));
    }

    function generateChainFoods() {
        foods = [];
        const correctText = currentChain.sequence[chainIndex];
        const others = [...new Set(currentChain.sequence)].filter(c => c !== correctText).sort(() => Math.random() - 0.5);
        const dummies = others.concat(["X", "Y", "Z"].filter(c => c !== correctText && !others.includes(c))).slice(0, 2);
        [correctText, ...dummies].sort(() => Math.random() - 0.5).forEach((t, i) => {
            const pos = getRandomPos();
            foods.push({ x: pos.x, y: pos.y, text: t, label: LETTERS[i], isCorrect: t === correctText });
        });
        renderAnswerPanel(foods.map(f => f.text));
    }

    function updateGame() {
        direction = nextDirection;
        let headX = snake[0].x;
        let headY = snake[0].y;

        if (direction === "LEFT") headX -= box;
        if (direction === "UP") headY -= box;
        if (direction === "RIGHT") headX += box;
        if (direction === "DOWN") headY += box;

        if (headX < 0) headX = canvas.width - box;
        else if (headX >= canvas.width) headX = 0;
        if (headY < 0) headY = canvas.height - box;
        else if (headY >= canvas.height) headY = 0;

        const newHead = { x: headX, y: headY };

        if (checkSelfCollision(newHead, snake)) {
            endGame(false, "Bạn đã tự cắn vào đuôi mình!");
            return;
        }

        snake.unshift(newHead);

        let eatenIndex = foods.findIndex(f => f.x === newHead.x && f.y === newHead.y);
        if (eatenIndex !== -1) {
            handleFoodEaten(foods[eatenIndex], true);
        } else {
            snake.pop();
        }

        if (currentMode === "versus") updateBotLogic();

        drawGame();
    }

    function handleFoodEaten(foodItem, isPlayer) {
        if (foodItem.isCorrect) playSound(523.25, 0.1, "sine");
        else playSound(180, 0.2, "sawtooth");

        if (currentMode === "arcade") {
            if (foodItem.isCorrect) {
                score += 10;
                document.getElementById("score").textContent = score;
                snake.push({...snake[snake.length - 1]});
            } else {
                score = Math.max(0, score - 5);
                document.getElementById("score").textContent = score;
                if (snake.length > 2) snake.pop();
                applyPoison();
            }
            generateArcadeFoods();
            return;
        }

        if (["smartFood", "versus", "hard"].includes(currentMode)) {
            if (foodItem.isCorrect) {
                if (isPlayer) {
                    score += 20;
                    document.getElementById("score").textContent = score;
                    if (score >= 100) { endGame(true, "Chúc mừng! Bạn đã đạt điểm tối đa 100!"); return; }
                } else {
                    botScore += 20;
                    document.getElementById("botScore").textContent = botScore;
                }
                setupQuestionOrChain();
            } else {
                if (isPlayer) {
                    score = Math.max(0, score - 10);
                    document.getElementById("score").textContent = score;
                    if (snake.length > 2) snake.pop();
                    applyPoison();
                }
                generateSmartFoods();
            }
        } else if (currentMode === "chain") {
            if (foodItem.isCorrect) {
                score += 10;
                chainIndex++;
                document.getElementById("score").textContent = score;
                if (chainIndex >= currentChain.sequence.length) {
                    score += 30;
                    document.getElementById("score").textContent = score;
                    if (score >= 100) { endGame(true, "Bạn đã hoàn thành chuỗi xuất sắc!"); return; }
                    setupQuestionOrChain();
                } else {
                    updateChainPrompt();
                    generateChainFoods();
                }
            } else {
                score = Math.max(0, score - 5);
                document.getElementById("score").textContent = score;
                if (snake.length > 2) snake.pop();
                generateChainFoods();
            }
        }
    }

    function applyPoison() {
        isPoisoned = true;
        const qBox = document.getElementById("questionBox");
        const prevText = qBox.innerHTML;
        qBox.innerHTML = `<span class="poisoned-status">🤢 TRÚNG ĐỘC! Đảo ngược phím 3s!</span>`;
        if (poisonTimer) clearTimeout(poisonTimer);
        poisonTimer = setTimeout(() => {
            isPoisoned = false;
            qBox.innerHTML = prevText;
        }, 3000);
    }

    function updateBotLogic() {
        let botHead = { ...botSnake[0] };
        let targetFood = foods.find(f => f.isCorrect) || foods[0];

        let possibleMoves = [];
        if (targetFood.x < botHead.x) possibleMoves.push({ x: botHead.x - box, y: botHead.y });
        if (targetFood.x > botHead.x) possibleMoves.push({ x: botHead.x + box, y: botHead.y });
        if (targetFood.y < botHead.y) possibleMoves.push({ x: botHead.x, y: botHead.y - box });
        if (targetFood.y > botHead.y) possibleMoves.push({ x: botHead.x, y: botHead.y + box });

        possibleMoves = possibleMoves.map(m => {
            let x = m.x, y = m.y;
            if (x < 0) x = canvas.width - box;
            else if (x >= canvas.width) x = 0;
            if (y < 0) y = canvas.height - box;
            else if (y >= canvas.height) y = 0;
            return { x, y };
        });

        let validMoves = possibleMoves.filter(move => !checkSelfCollision(move, botSnake));
        if (validMoves.length > 0) botHead = validMoves[0];
        else botHead.x = (botHead.x + box) % canvas.width;

        if (checkSelfCollision(botHead, botSnake)) {
            botSnake = [{ x: 20 * box, y: 18 * box }, { x: 21 * box, y: 18 * box }];
            return;
        }

        botSnake.unshift(botHead);
        let botEatenIndex = foods.findIndex(f => f.x === botHead.x && f.y === botHead.y);
        if (botEatenIndex !== -1) handleFoodEaten(foods[botEatenIndex], false);
        else botSnake.pop();
    }

    function checkSelfCollision(head, array) {
        for (let i = 0; i < array.length; i++) {
            if (head.x === array[i].x && head.y === array[i].y) return true;
        }
        return false;
    }

    function drawGame() {
        ctx.fillStyle = "#111827";
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        ctx.strokeStyle = "#1f2937";
        for (let i = 0; i <= canvas.width; i += box) {
            ctx.beginPath(); ctx.moveTo(i, 0); ctx.lineTo(i, canvas.height); ctx.stroke();
        }
        for (let i = 0; i <= canvas.height; i += box) {
            ctx.beginPath(); ctx.moveTo(0, i); ctx.lineTo(canvas.width, i); ctx.stroke();
        }

        if (gameState === "HOME") return;

        // Rắn người chơi
        snake.forEach((part, index) => {
            ctx.fillStyle = index === 0 ? (isPoisoned ? "#a855f7" : snakeHead) : snakeBody;
            ctx.fillRect(part.x, part.y, box - 2, box - 2);
        });

        // Rắn Bot
        if (currentMode === "versus") {
            botSnake.forEach((part, index) => {
                ctx.fillStyle = index === 0 ? "#e11d48" : "#fb7185";
                ctx.fillRect(part.x, part.y, box - 2, box - 2);
            });
        }

        // Mồi
        foods.forEach(f => {
            ctx.fillStyle = f.type === "bad" ? "#ef4444" : "#38bdf8";
            ctx.beginPath();
            if (ctx.roundRect) ctx.roundRect(f.x, f.y, box, box, 5);
            else ctx.rect(f.x, f.y, box, box);
            ctx.fill();

            ctx.fillStyle = "#0f172a";
            ctx.font = f.label ? "bold 14px Arial" : "bold 11px Arial";
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            ctx.fillText(latexToPlain(f.label ?? f.text), f.x + box / 2, f.y + box / 2);
        });
    }

