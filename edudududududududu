    let editingQ = -1;   // vị trí câu đang sửa (-1 = đang thêm mới)

    function refreshEditUI() {
        el("addQBtn").textContent = editingQ >= 0 ? `💾 Lưu thay đổi (câu ${editingQ + 1})` : "➕ Thêm câu hỏi";
        el("cancelEditQ").style.display = editingQ >= 0 ? "inline-block" : "none";
    }

    function clearQuestionForm() {
        ["customQ", "customAns", "customOpt1", "customOpt2"].forEach(id => { el(id).value = ""; });
        clearPendingImage();
        updateQPreview();
    }

    function startEditQuestion(i) {
        const it = customQuestions[i];
        if (!it) return;
        const others = it.options.filter(o => o !== it.answer);
        el("customQ").value = it.q;
        el("customAns").value = it.answer;
        el("customOpt1").value = others[0] || "";
        el("customOpt2").value = others[1] || "";
        pendingImage = it.image || "";
        el("customImg").value = pendingImage.startsWith("data:") ? "" : pendingImage;
        updatePendingPreview();
        updateQPreview();
        editingQ = i;
        refreshEditUI();
        el("customQ").scrollIntoView({ behavior: "smooth", block: "center" });
        el("customQ").focus();
    }

    function cancelEditQuestion() {
        editingQ = -1;
        clearQuestionForm();
        refreshEditUI();
    }

    function addCustomQuestion() {
        const q = document.getElementById("customQ").value.trim();
        const ans = document.getElementById("customAns").value.trim();
        const opt1 = document.getElementById("customOpt1").value.trim();
        const opt2 = document.getElementById("customOpt2").value.trim();

        if (!q || !ans || !opt1 || !opt2) {
            alert("Vui lòng nhập đầy đủ câu hỏi và các lựa chọn!");
            return;
        }

        const newQ = { q: q, options: [ans, opt1, opt2], answer: ans, image: pendingImage };
        const wasEditing = editingQ;
        const oldQ = wasEditing >= 0 ? customQuestions[wasEditing] : null;
        if (wasEditing >= 0) customQuestions[wasEditing] = newQ; else customQuestions.push(newQ);
        if (!saveQuestions()) {
            if (wasEditing >= 0) customQuestions[wasEditing] = oldQ; else customQuestions.pop();
            return;
        }
        editingQ = -1;
        refreshEditUI();

        document.getElementById("customQ").value = "";
        document.getElementById("customAns").value = "";
        document.getElementById("customOpt1").value = "";
        document.getElementById("customOpt2").value = "";
        clearPendingImage();
        updateQPreview();

        renderCustomQuizList();
        alert(wasEditing >= 0 ? "Đã lưu thay đổi!" : "Thêm câu hỏi thành công!");
    }

    function removeCustomQuestion(index) {
        if (editingQ === index) cancelEditQuestion(); else if (editingQ > index) { editingQ--; refreshEditUI(); }
        customQuestions.splice(index, 1);
        saveQuestions();
        renderCustomQuizList();
    }

