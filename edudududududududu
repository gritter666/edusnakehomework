<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EduSnake - Rắn Săn Mồi Học Tập MultiMath & Visual</title>

    <!-- Thư viện KaTeX hỗ trợ Công thức Toán học (Tích phân, Phân số, Căn thức,...) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"></script>

    <style>
        :root { --accent: #22c55e; --accent-light: #4ade80; --bg2: #064e3b; --glow: rgba(34, 197, 94, 0.3); }
        body.hard { --accent: #ef4444; --accent-light: #f87171; --bg2: #7f1d1d; --glow: rgba(239, 68, 68, 0.45); }

        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #0f172a, var(--bg2));
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: white;
            padding: 10px;
            user-select: none;
        }

        .game-container {
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
            max-width: 1128px;
            position: relative;
        }

        h1 { margin: 0 0 10px 0; color: var(--accent-light); font-size: 26px; }

        .top-bar {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            width: 100%;
            background: rgba(17, 24, 39, 0.85);
            border: 2px solid var(--accent);
            border-radius: 10px;
            padding: 10px 15px;
            margin-bottom: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        }

        .control-group { display: flex; align-items: center; gap: 8px; }
        .control-group label { font-size: 14px; font-weight: bold; color: #cbd5e1; }

        select, button {
            padding: 6px 12px;
            border-radius: 6px;
            border: 1px solid var(--accent);
            background: #1f2937;
            color: var(--accent-light);
            font-size: 14px;
            font-weight: bold;
            outline: none;
            cursor: pointer;
            transition: all 0.2s;
        }
        button:hover { filter: brightness(1.2); }

        button.btn-primary { background: var(--accent); color: white; border: none; }
        button.btn-custom { background: #0284c7; color: white; border: none; }
        button.btn-danger { background: #ef4444; color: white; border: none; }
        button.btn-warning { background: #f59e0b; color: white; border: none; }

        .question-box {
            flex: 1;
            min-width: 250px;
            background: #1e293b;
            border: 1px dashed #38bdf8;
            border-radius: 6px;
            padding: 6px 12px;
            font-size: 15px;
            font-weight: bold;
            color: #f1f5f9;
            text-align: center;
            min-height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .info-scores { display: flex; gap: 12px; font-size: 14px; font-weight: bold; }

        .canvas-wrapper {
            position: relative;
            width: 660px;
            height: 484px;
        }

        canvas {
            background: #111827;
            border: 4px solid var(--accent);
            border-radius: 10px;
            box-shadow: 0 0 30px var(--glow);
            display: block;
            width: 100%;
            height: 100%;
        }

        /* KHUNG HÌNH ẢNH NẰM NGOÀI SÂN CHƠI */
        .play-area { display: flex; flex-wrap: wrap; justify-content: center; align-items: stretch; gap: 14px; width: 100%; }
        .side-panel { width: 220px; background: rgba(17, 24, 39, 0.85); border: 2px solid #38bdf8; border-radius: 10px; padding: 10px; display: flex; flex-direction: column; gap: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.3); }
        .side-panel h3 { margin: 0; font-size: 15px; color: #38bdf8; }
        .side-img-box { flex: 1; min-height: 180px; display: flex; align-items: center; justify-content: center; overflow: auto; background: #0f172a; border: 1px dashed #334155; border-radius: 8px; padding: 6px; }
        .side-img-box img { display: none; max-width: 100%; max-height: 420px; object-fit: contain; border-radius: 4px; }
        .side-empty { color: #64748b; font-size: 13px; text-align: center; }

        /* KHUNG ĐÁP ÁN A/B/C BÊN TRÁI */
        .answer-list { display: flex; flex-direction: column; gap: 8px; text-align: left; }
        .answer-item { display: flex; align-items: center; gap: 8px; background: #0f172a; border: 1px solid #334155; border-radius: 8px; padding: 8px; font-size: 15px; min-height: 44px; }
        .answer-letter { flex-shrink: 0; width: 28px; height: 28px; border-radius: 6px; background: #38bdf8; color: #0f172a; font-weight: bold; display: flex; align-items: center; justify-content: center; }

        /* THANH CÔNG THỨC */
        .question-box .katex { font-size: 1.15em; }
        .formula-bar { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px; }
        .fbtn { padding: 3px 7px; min-width: 34px; font-size: 13px; background: #0f172a; color: #e2e8f0; border: 1px solid #475569; }
        .fbtn .katex { font-size: 1em; }
        .formula-preview { margin-top: 6px; padding: 8px; background: #0f172a; border: 1px dashed #38bdf8; border-radius: 6px; font-size: 14px; line-height: 1.8; }

        .bottom-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            margin-top: 10px;
        }

        .guide { color: #cbd5e1; font-size: 13px; }

        .poisoned-status { color: #ef4444; font-weight: bold; animation: blink 0.5s infinite alternate; }
        @keyframes blink { from { opacity: 1; } to { opacity: 0.3; } }

        /* OVERLAY / SCREEN STYLES */
        .overlay-screen {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(15, 23, 42, 0.96);
            border-radius: 10px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 50;
            gap: 12px;
            padding: 20px;
        }

        .overlay-title { font-size: 32px; font-weight: bold; color: var(--accent-light); margin-bottom: 5px; }
        .overlay-subtitle { font-size: 14px; color: #94a3b8; margin-bottom: 15px; }
        .menu-btn { width: 260px; padding: 12px; font-size: 15px; margin: 4px 0; display: flex; align-items: center; justify-content: center; gap: 8px; }

        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.85);
            justify-content: center;
            align-items: center;
            z-index: 100;
        }

        .modal-content {
            background: #1e293b;
            border: 2px solid var(--accent);
            border-radius: 12px;
            padding: 20px;
            width: 90%;
            max-width: 640px;
            color: white;
            max-height: 85vh;
            overflow-y: auto;
        }

        .modal-content h2 { margin-top: 0; color: var(--accent-light); font-size: 20px; }
        .modal-content h3 { color: #38bdf8; font-size: 16px; margin: 15px 0 8px 0; border-bottom: 1px solid #334155; padding-bottom: 4px; }

        .form-group { margin-bottom: 12px; text-align: left; }
        .form-group label { display: block; font-size: 13px; margin-bottom: 4px; color: #cbd5e1; }
        .form-group input, .form-group select {
            width: 100%; padding: 8px; border-radius: 6px;
            border: 1px solid #475569; background: #0f172a; color: white; font-size: 14px;
        }

        .key-bind-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
        .key-btn { width: 100px; padding: 4px; text-align: center; }
        
        .quiz-list { margin-top: 15px; border-top: 1px solid #475569; padding-top: 10px; text-align: left; max-height: 200px; overflow-y: auto; }
        .quiz-item { display: flex; justify-content: space-between; align-items: center; background: #0f172a; padding: 8px 12px; border-radius: 6px; margin-bottom: 6px; font-size: 13px; border: 1px solid #334155; }
        .quiz-item-img { width: 44px; height: 44px; object-fit: cover; border-radius: 4px; margin-right: 8px; border: 1px solid #38bdf8; }
        .quiz-item-noimg { width: 44px; height: 44px; border-radius: 4px; margin-right: 8px; border: 1px dashed #475569; display: flex; align-items: center; justify-content: center; color: #64748b; font-size: 18px; flex-shrink: 0; }
        .quiz-item-actions { display: flex; flex-direction: column; gap: 4px; margin-left: 8px; }
        .quiz-item-actions button { padding: 4px 8px; font-size: 11px; border-radius: 4px; border: none; color: white; white-space: nowrap; }

        .img-import { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 6px; }
        .img-import .btn-file { background: #0284c7; color: white; border: none; padding: 6px 10px; font-size: 13px; }
        .img-import .btn-clear { background: #ef4444; color: white; border: none; padding: 6px 10px; font-size: 13px; }
        .img-preview { max-width: 80px; max-height: 60px; border-radius: 4px; border: 2px solid #38bdf8; background: #0f172a; display: none; object-fit: contain; }
        .img-hint { font-size: 11px; color: #94a3b8; margin-top: 4px; }
    
        /* MÀN HÌNH ĐĂNG NHẬP / ĐĂNG KÝ */
        .auth-screen { position: fixed; inset: 0; z-index: 2000; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #0f172a, var(--bg2)); overflow: auto; padding: 16px; }
        .auth-card { width: 100%; max-width: 400px; background: #111827; border: 2px solid var(--accent); border-radius: 14px; padding: 22px; box-shadow: 0 0 25px var(--glow); text-align: left; }
        .auth-card h1 { text-align: center; margin: 0 0 4px; }
        .auth-tabs { display: flex; gap: 6px; margin: 12px 0; }
        .auth-tabs button { flex: 1; }
        .form-group select { width: 100%; padding: 8px; background: #0f172a; color: #e2e8f0; border: 1px solid #475569; border-radius: 6px; }
            .set-select { width: 100%; box-sizing: border-box; padding: 8px; border-radius: 6px; border: 1px solid #475569; background: #0f172a; color: #e2e8f0; font-size: 14px; }
        body.is-teacher .student-only { display: none !important; }
        body:not(.is-teacher) .teacher-only { display: none !important; }
    </style>
</head>
<body>

<div class="game-container">
    <h1>🐍 EduSnake - MultiMath & Visual</h1>
    <div id="userBar" class="img-hint" style="display:none; margin-bottom:6px;"><span id="userName"></span> <button onclick="logout()" style="padding:2px 8px; font-size:11px; background:#475569; color:white; border:none; margin-left:6px;">Đăng xuất</button></div>
    <div id="assignBanner" class="img-hint" style="display:none; margin-bottom:6px;"></div>

    <!-- TOP BAR -->
    <div class="top-bar" id="gameTopBar">
        <div class="control-group">
            <label for="gameMode">🎮 Chế độ:</label>
            <select id="gameMode" onchange="changeModeInGame()">
                <option value="smartFood">🍎 Mồi Thông Minh (Học)</option>
                <option value="chain">🔗 Nối Chuỗi (Học)</option>
                <option value="versus">⚔️ Đối Kháng Bot (Học)</option>
                <option value="hard">🔥 Siêu Khó (Học)</option>
                <option value="arcade">🕹️ Chơi Giải Trí (Không Học)</option>
            </select>
        </div>

        <button class="btn-custom teacher-only" onclick="openCustomModal()">📚 Ngân hàng câu hỏi</button>

        <div class="question-box" id="questionBox">Đang tải...</div>

        <div class="info-scores">
            <span>🏆: <span id="score">0</span></span>
            <span id="botScoreContainer" style="display: none; color: #f43f5e;">🤖: <span id="botScore">0</span></span>
            <span>⏱️: <span id="timeText">00:00</span></span>
        </div>
    </div>

    <!-- CANVAS & SCREEN OVERLAYS -->
    <div class="play-area">
    <div class="side-panel">
        <h3>✅ Đáp án</h3>
        <div class="answer-list" id="answerList"></div>
    </div>
    <div class="canvas-wrapper" id="canvasWrapper">
        <canvas id="gameCanvas" width="660" height="484"></canvas>

        <!-- TRANG CHỦ CHÍNH -->
        <div id="homeScreen" class="overlay-screen">
            <div class="overlay-title">🐍 EDUSNAKE</div>
            <div class="overlay-subtitle">Tích hợp Toán LaTeX, Hình ảnh & Đa dạng kiến thức</div>
            <button class="btn-primary menu-btn" onclick="selectModeAndStart('smartFood')">📚 Vừa Học Vừa Chơi</button>
            <button class="btn-danger menu-btn" onclick="selectModeAndStart('hard')">🔥 Chế Độ Siêu Khó</button>
            <button class="btn-warning menu-btn" onclick="selectModeAndStart('arcade')">🕹️ Chơi Giải Trí (Không Học)</button>
            <button class="btn-custom menu-btn teacher-only" onclick="openCustomModal()">📝 Quản Lý Câu Hỏi & Ảnh</button>
            <button class="btn-custom menu-btn" onclick="openCloudModal()">☁️ Lớp Học / Giao Bài</button>
            <button class="btn-custom menu-btn" onclick="openSettingsModal()">⚙️ Cài Đặt Hệ Thống</button>
        </div>

        <!-- PAUSE MENU -->
        <div id="pauseMenuScreen" class="overlay-screen" style="display: none;">
            <div class="overlay-title" style="color: #38bdf8;">⏸️ TẠM DỪNG</div>
            <button class="btn-primary menu-btn" onclick="resumeGame()">▶️ Tiếp Tục</button>
            <button class="btn-custom menu-btn" onclick="openSettingsModal()">⚙️ Cài Đặt</button>
            <button class="btn-danger menu-btn" onclick="returnToHomeScreen()">🏠 Về Trang Chủ</button>
        </div>

        <!-- GAME OVER / VICTORY SCREEN -->
        <div id="resultScreen" class="overlay-screen" style="display: none;">
            <div id="resultTitle" class="overlay-title">GAME OVER</div>
            <div id="resultDetails" style="font-size: 16px; margin-bottom: 10px; text-align: center; line-height: 1.6;"></div>
            <button class="btn-primary menu-btn" onclick="startNewGame()">🔄 Chơi Lại</button>
            <button class="btn-custom menu-btn" onclick="returnToHomeScreen()">🏠 Về Trang Chủ</button>
        </div>
    </div>
    <div class="side-panel">
        <h3>🖼️ Hình minh họa</h3>
        <div class="side-img-box">
            <img id="qImg" alt="Hình minh họa">
            <div class="side-empty" id="qImgEmpty">Câu hỏi này không có ảnh</div>
        </div>
    </div>
    </div>

    <!-- BOTTOM BAR -->
    <div class="bottom-bar" id="gameBottomBar">
        <div class="guide" id="controlGuideText">Di chuyển: Phím mũi tên / WASD | Esc: Tạm dừng | Xuyên tường OK</div>
        <div>
            <button class="btn-custom" onclick="pauseGame()">⏸️ Tạm Dừng</button>
            <button class="btn-danger" onclick="returnToHomeScreen()">🏠 Trang Chủ</button>
        </div>
    </div>
</div>

<!-- MODAL CÀI ĐẶT -->
<div class="modal" id="settingsModal">
    <div class="modal-content">
        <h2>⚙️ Cài Đặt Hệ Thống</h2>
        
        <h3>🔊 Âm Thanh</h3>
        <div class="form-group">
            <label>Nhạc nền (BGM): <span id="bgmVolText">50%</span></label>
            <input type="range" id="bgmVol" min="0" max="100" value="50" oninput="updateAudioSettings()">
        </div>
        <div class="form-group">
            <label>Hiệu ứng (SFX): <span id="sfxVolText">80%</span></label>
            <input type="range" id="sfxVol" min="0" max="100" value="80" oninput="updateAudioSettings()">
        </div>

        <h3>🖥️ Đồ Họa & Tốc Độ</h3>
        <div class="form-group">
            <label>Độ phân giải Màn chơi:</label>
            <select id="resSelect" onchange="changeResolution()">
                <option value="660x484">Chuẩn (660 x 484)</option>
                <option value="550x418">Nhỏ (550 x 418)</option>
                <option value="770x506">Lớn (770 x 506)</option>
            </select>
        </div>
        <div class="form-group">
            <label>Giới hạn FPS (Tốc độ game):</label>
            <select id="fpsSelect" onchange="changeFPS()">
                <option value="150">Bình thường (Chậm - Dễ)</option>
                <option value="100" selected>Nhanh (Vừa - Chuẩn)</option>
                <option value="60">Rất nhanh (Nhanh - Khó)</option>
            </select>
        </div>

        <h3>🎮 Điều Khiển</h3>
        <div class="key-bind-row">
            <span>Lên:</span>
            <button class="key-btn" onclick="listenKey('UP')" id="keyBtn_UP">ArrowUp</button>
        </div>
        <div class="key-bind-row">
            <span>Xuống:</span>
            <button class="key-btn" onclick="listenKey('DOWN')" id="keyBtn_DOWN">ArrowDown</button>
        </div>
        <div class="key-bind-row">
            <span>Trái:</span>
            <button class="key-btn" onclick="listenKey('LEFT')" id="keyBtn_LEFT">ArrowLeft</button>
        </div>
        <div class="key-bind-row">
            <span>Phải:</span>
            <button class="key-btn" onclick="listenKey('RIGHT')" id="keyBtn_RIGHT">ArrowRight</button>
        </div>

        <button class="btn-primary" style="width: 100%; margin-top: 15px;" onclick="closeSettingsModal()">Đóng & Lưu</button>
    </div>
</div>

<!-- MODAL CÂU HỎI HỌC TẬP (CÓ CÔNG THỨC TOÁN & HÌNH ẢNH) -->
<div class="modal" id="customModal">
    <div class="modal-content">
        <h2>📚 Quản Lý Câu Hỏi & Đồ Họa</h2>
        <div style="border:1px solid #475569; border-radius:8px; padding:8px; margin-bottom:10px;">
            <label style="font-size:13px; color:#94a3b8;">📂 Bộ đề của tôi (lưu trên mạng, mỗi bộ gồm trắc nghiệm + nối chuỗi):</label>
            <select id="setSelect" class="set-select" style="margin-top:4px;" onchange="openSet()"></select>
            <div style="display:flex; gap:6px; margin-top:6px; flex-wrap:wrap;">
                <button class="btn-primary" onclick="saveSetAs()">➕ Lưu thành bộ đề mới</button>
                <button style="background:#f59e0b; color:white; border:none;" onclick="updateSet()">💾 Cập nhật bộ đề</button>
                <button class="btn-danger" onclick="deleteSet()">🗑 Xóa bộ đề</button>
            </div>
            <div class="img-hint" id="setMsg" style="margin-top:6px;"></div>
        </div>
        <div style="display:flex; gap:6px; margin-bottom:10px;">
            <button id="tabBtnQuiz" class="btn-primary" style="flex:1;" onclick="switchTab('quiz')">📝 Trắc nghiệm</button>
            <button id="tabBtnChain" style="flex:1;" onclick="switchTab('chain')">🔗 Nối chuỗi</button>
        </div>
        <div id="tabQuiz">
        
        <div class="form-group">
            <label>Nội dung câu hỏi (bọc công thức trong <code>$...$</code>, hoặc bấm nút bên dưới):</label>
            <input type="text" id="customQ" placeholder="Ví dụ: Tính $\int_0^2 2x\,dx$ = ?">
            <div class="img-hint">Nút công thức sẽ chèn vào ô đang chọn (câu hỏi hoặc đáp án).</div>
            <div class="formula-bar" id="formulaBar"></div>
            <div class="formula-preview" id="qPreview" style="display:none;"></div>
        </div>
        
        <div class="form-group">
            <label>Hình ảnh minh họa (không bắt buộc):</label>
            <div class="img-import">
                <button type="button" class="btn-file" onclick="document.getElementById('customImgFile').click()">📁 Chọn ảnh từ máy</button>
                <button type="button" class="btn-clear" id="customImgClear" style="display:none;" onclick="clearPendingImage()">✖ Bỏ ảnh</button>
                <img id="customImgPreview" class="img-preview" alt="Xem trước">
            </div>
            <input type="file" id="customImgFile" accept="image/*" style="display:none;" onchange="onCustomImgFile(this)">
            <input type="text" id="customImg" placeholder="...hoặc dán URL ảnh: https://example.com/image.png" style="margin-top:6px;" oninput="onCustomImgUrl()">
            <div class="img-hint">Ảnh tải từ máy sẽ được tự động thu nhỏ (tối đa 400px) để lưu gọn trong trình duyệt.</div>
        </div>
        <input type="file" id="itemImgFile" accept="image/*" style="display:none;" onchange="onItemImgFile(this)">

        <div class="form-group"><label>Đáp án đúng:</label><input type="text" id="customAns" placeholder="Ví dụ: 4"></div>
        <div class="form-group"><label>Đáp án sai 1:</label><input type="text" id="customOpt1" placeholder="Ví dụ: 2"></div>
        <div class="form-group"><label>Đáp án sai 2:</label><input type="text" id="customOpt2" placeholder="Ví dụ: 6"></div>
        
        <div style="display: flex; gap: 8px;">
            <button class="btn-primary" id="addQBtn" style="flex: 1;" onclick="addCustomQuestion()">➕ Thêm câu hỏi</button>
            <button id="cancelEditQ" style="padding: 6px; background: #f59e0b; color: white; border: none; display: none;" onclick="cancelEditQuestion()">✖ Hủy sửa</button>
            <button class="btn-danger" style="padding: 6px;" onclick="resetDefaultQuestions()">🔄 Khôi phục gốc</button>
        </div>

        <h3>Danh sách câu hỏi hiện có:</h3>
        <div class="quiz-list" id="quizList"></div>
        </div>

        <div id="tabChain" style="display:none;">
            <div class="img-hint" style="margin-bottom:10px;">Chế độ Nối Chuỗi: rắn phải ăn các phần tử lần lượt theo đúng thứ tự bạn đặt. Mồi sai là các phần tử khác trong chuỗi.</div>
            <div class="form-group">
